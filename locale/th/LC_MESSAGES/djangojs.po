msgstr[0] "มีตัวเลือกที่เลือกไว้ %s รายการซึ่งไม่แสดงอยู่"

msgid "(click to clear)"
msgstr "(คลิกเพื่อล้าง)"

msgid "Choose %s by selecting them and then select the "
msgstr "เลือก %s แล้วกดปุ่ม "

msgid "Choose all %s"
