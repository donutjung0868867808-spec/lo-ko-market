msgid "Monday"
msgstr "วันจันทร์"

msgid "Remove %s by selecting them and then select the "
msgstr "เลือก %s ที่ต้องการนำออก แล้วกดปุ่ม "

msgid "Remove all %s"
msgstr "นำ %s ออกทั้งหมด"

msgid "Remove selected %s"
msgstr "นำ %s ที่เลือกออก"

msgid "Saturday"
msgstr "วันเสาร์"

msgid "Sunday"
msgstr "วันอาทิตย์"

msgid "Thursday"
msgstr "วันพฤหัสบดี"

msgid "Tuesday"
msgstr "วันอังคาร"

msgid "Type into this box to filter down the list of selected %s."
msgstr "พิมพ์ในช่องนี้เพื่อกรองรายการ %s ที่เลือกไว้"

msgid "Wednesday"
